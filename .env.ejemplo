# Variables de entorno que hay que exportar antes de arrancar: la app NO lee este fichero.
# En PowerShell: $env:NOMBRE = "valor"
NODE_ENV=desarrollo
PUERTO=3000

DATABASE_URL=postgresql://postulaciones:desarrollo@localhost:5432/postulaciones

# Mínimo 32 caracteres. Generar con:  openssl rand -base64 48
JWT_SECRETO=cambia-esto-por-un-valor-aleatorio-de-al-menos-32-caracteres

MINUTOS_ACCESO=15
DIAS_REFRESCO=30

# Orígenes permitidos por CORS, separados por comas. Vacío = ninguno.
ORIGENES=http://localhost:5173
